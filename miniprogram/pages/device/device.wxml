<view class="device-page">
  <!-- 我的设备 -->
  <view class="my-devices-section">
    <view class="section-title">我的设备</view>
    <view wx:if="{{connectedDevicesHistory.length === 0}}" class="empty-hint">
      暂无已连接设备
    </view>
    <view wx:else class="device-list">
      <view 
        wx:for="{{connectedDevicesHistory}}" 
        wx:key="deviceId" 
        class="device-item {{item.isConnected ? 'connected' : ''}}"
      >
        <view class="device-main">
          <view class="device-name">{{item.deviceName}}</view>
          <view class="device-meta">
            <text class="status-dot {{item.isConnected ? 'online' : 'offline'}}"></text>
            <text class="device-status">{{item.isConnected ? '已连接' : '离线'}}</text>
            <text class="device-time">{{item.lastConnectTime}}</text>
          </view>
        </view>
        <button 
          class="unbind-btn" 
          bindtap="quickUnbindDevice" 
          data-device-id="{{item.deviceId}}"
          size="mini"
        >
          解绑
        </button>
      </view>
    </view>
  </view>

  <!-- 附近设备 -->
  <view class="nearby-devices-section">
    <view class="section-title">附近设备</view>
    <view wx:if="{{isScanning}}" class="scanning-hint">
      正在扫描附近设备...
    </view>
    <view wx:if="{{!isScanning && unDevices.length === 0}}" class="empty-hint">
      点击下方按钮开始扫描
    </view>
    <view wx:else class="device-list">
      <view 
        wx:for="{{unDevices}}" 
        wx:key="deviceId" 
        class="device-item nearby"
        bindtap="quickConnectDevice"
        data-device-id="{{item.deviceId}}"
        data-device-name="{{item.name}}"
      >
        <view class="device-main">
          <view class="device-name">{{item.name}}</view>
          <view class="device-meta">
            <text class="signal-strength">信号: {{item.RSSI}}dBm</text>
          </view>
        </view>
        <view class="connect-arrow">→</view>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-actions">
    <button 
      wx:if="{{!isScanning}}" 
      class="action-btn primary" 
      bindtap="startScan"
    >
      开始扫描
    </button>
    <button 
      wx:else 
      class="action-btn secondary" 
      bindtap="stopScan"
    >
      停止扫描
    </button>
  </view>
</view>
