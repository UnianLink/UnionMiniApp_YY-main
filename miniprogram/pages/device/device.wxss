/* ===== 整体容器样式 ===== */
page {
  background-color: #000;
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
}

.container {
  padding: 0;
  background: #000;
  min-height: 100vh;
  color: #fff;
}

/* ===== 扫描界面样式 ===== */
.scan-container {
  padding: 32rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #1a1a1a 0%, #0d1117 100%);
}

/* 顶部标题区域 */
.scan-title-area {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.scan-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.scan-subtitle {
  display: block;
  font-size: 28rpx;
  color: #8b949e;
  line-height: 1.5;
}

/* 蓝牙错误提示 */
.bluetooth-error-banner {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.1) 0%, rgba(255, 71, 87, 0.1) 100%);
  border: 1px solid rgba(255, 107, 107, 0.3);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fadeIn 0.3s ease;
}

.bluetooth-error-banner .error-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.bluetooth-error-banner .error-message {
  font-size: 30rpx;
  color: #ff6b6b;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.bluetooth-error-banner .error-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 扫描按钮区域 */
.scan-button-area {
  text-align: center;
  padding: 40rpx 0;
  margin-bottom: 32rpx;
}

.scan-button {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 60rpx;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
  width: 280rpx;
  height: 120rpx;
  margin: 0 auto;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.scan-button.scanning {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  animation: pulse 2s infinite;
}

.scan-button:active {
  transform: scale(0.95);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.button-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}

.scanning-indicator {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.scan-wave {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 60rpx;
  height: 60rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: wave 2s linear infinite;
}

.scan-wave.delay {
  animation-delay: 1s;
}

.scan-hint {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #7f8c8d;
  letter-spacing: 0.5rpx;
}

@keyframes wave {
  0% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(3);
    opacity: 0;
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

/* 设备发现区域 */
.device-discovery-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  padding: 32rpx;
  min-height: 400rpx;
}

/* 扫描中状态 */
.scanning-state {
  text-align: center;
  animation: fadeIn 0.5s ease;
}

.scanning-animation {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 32rpx;
  gap: 16rpx;
}

.scanning-circle {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  animation: scanningPulse 1.5s infinite ease-in-out;
}

.scanning-circle:nth-child(2) {
  animation-delay: 0.2s;
}

.scanning-circle:nth-child(3) {
  animation-delay: 0.4s;
}

.scanning-text {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

/* 设备发现状态 */
.device-found-state {
  animation: slideUp 0.6s ease;
  width: 100%;
}

/* 设备列表标题 */
.devices-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.devices-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.devices-scanning-status {
  font-size: 24rpx;
  color: #667eea;
  animation: blink 1.5s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 连接引导动画 */
.connection-guide {
  margin-bottom: 48rpx;
  position: relative;
}

.guide-ring {
  width: 120rpx;
  height: 120rpx;
  border: 3rpx solid rgba(102, 126, 234, 0.3);
  border-radius: 50%;
  position: relative;
  margin: 0 auto;
  animation: rotate 3s linear infinite;
}

.guide-dot {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
}

.guide-dot:nth-child(2) {
  top: 50%;
  right: -6rpx;
  left: auto;
  transform: translateY(-50%);
}

.guide-dot:nth-child(3) {
  bottom: -6rpx;
  top: auto;
  left: 50%;
  transform: translateX(-50%);
}

.connection-guide.animate .guide-ring {
  animation: rotate 2s linear infinite;
}

/* 设备卡片 */
.device-card {
  background: linear-gradient(135deg, #1a1a1a 0%, #161b22 100%);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  min-height: 120rpx;
  position: relative;
  color: #ffffff;
}

.device-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.3);
  border-color: rgba(102, 126, 234, 0.5);
}

/* 主设备卡片（最强信号） */
.device-card.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.4);
  margin-bottom: 32rpx;
}

/* 次要设备卡片 */
.device-card.secondary {
  background: #f8f9fa;
  padding: 24rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.device-card:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.device-card.primary:active {
  border-color: #764ba2;
}

/* 最强信号标签 */
.best-signal-badge {
  position: absolute;
  top: -12rpx;
  right: 24rpx;
  background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
  color: white;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 8rpx rgba(243, 156, 18, 0.3);
}

.device-icon {
  margin-right: 24rpx;
  flex-shrink: 0;
}

.device-icon.small {
  margin-right: 16rpx;
}

.necklace-icon {
  font-size: 56rpx;
  animation: sparkle 2s ease-in-out infinite;
}

.device-icon.small .necklace-icon {
  font-size: 40rpx;
}

.device-info {
  flex: 1;
  text-align: left;
  min-width: 0; /* 防止文字溢出 */
}

.device-name-subtle {
  display: block;
  font-size: 22rpx;
  color: #8b949e;
  margin-bottom: 6rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.5rpx;
}

.device-signal {
  display: block;
  font-size: 26rpx;
  color: #c9d1d9;
  font-weight: 500;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

.device-signal.strong {
  color: #39d353;
  font-weight: 600;
}

.device-update-time {
  display: block;
  font-size: 20rpx;
  color: #6e7681;
  margin-top: 4rpx;
}

/* 其他设备列表 */
.other-devices {
  margin-top: 24rpx;
}

.other-devices-title {
  display: block;
  font-size: 28rpx;
  color: #7f8c8d;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.connect-button {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-weight: 600;
  font-size: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  flex-shrink: 0;
  white-space: nowrap;
}

.connect-text {
  margin-right: 8rpx;
  letter-spacing: 0.5rpx;
}

.connect-arrow {
  font-size: 28rpx;
  animation: bounce 1s ease-in-out infinite;
}

/* 连接提示 */
.connection-tip {
  text-align: center;
  animation: fadeIn 0.8s ease 0.3s both;
}

.connection-tip text {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.tip-subtitle {
  font-size: 22rpx !important;
  color: #999 !important;
  font-weight: 400 !important;
  letter-spacing: 0.5rpx !important;
  white-space: nowrap !important;
}

/* 未发现设备状态 */
.no-devices {
  text-align: center;
  animation: fadeIn 0.5s ease;
}

.no-device-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.no-device-text {
  display: block;
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.no-devices-tip {
  font-size: 22rpx !important;
  color: #999 !important;
  display: block !important;
  letter-spacing: 0.5rpx !important;
  white-space: nowrap !important;
}

/* 动画定义 */
@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes scanningPulse {
  0%, 100% { 
    transform: scale(1);
    opacity: 0.6;
  }
  50% { 
    transform: scale(1.2);
    opacity: 1;
  }
}

@keyframes sparkle {
  0%, 100% { 
    transform: scale(1) rotate(0deg);
    filter: brightness(1);
  }
  50% { 
    transform: scale(1.1) rotate(5deg);
    filter: brightness(1.2);
  }
}

@keyframes bounce {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(4rpx); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { 
    opacity: 0;
    transform: translateY(40rpx);
  }
  to { 
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 设备详情界面样式 ===== */
.device-detail-container {
  background: linear-gradient(135deg, #1a1a1a 0%, #0d1117 100%);
  height: 100vh;
  color: #fff;
  display: flex;
  flex-direction: column;
}

.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  flex-shrink: 0;
}

/* 可滚动内容区域 - 为小程序底部导航栏预留空间 */
.scrollable-content {
  flex: 1;
  height: calc(100vh - 100rpx);
  padding: 0 32rpx;
}

.device-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.back-button {
  background: rgba(255, 255, 255, 0.1);
  color: #c9d1d9;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  min-height: 64rpx;
  line-height: 32rpx;
  transition: all 0.3s ease;
}

.back-button:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

/* 区块间距样式 */
.section { 
  margin: 24rpx 0;
  background: linear-gradient(135deg, #1a1a1a 0%, #161b22 100%);
  border: 1rpx solid rgba(102, 126, 234, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.clear-button {
  background: linear-gradient(135deg, #ff4757 0%, #e74c3c 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  min-height: 48rpx;
  line-height: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 71, 87, 0.3);
  transition: all 0.3s ease;
}

.clear-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.5);
}

/* 设备信息样式 */
.device-info {
  display: flex;
  margin-bottom: 16rpx;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #8b949e;
  width: 140rpx;
  flex-shrink: 0;
  letter-spacing: 0.5rpx;
}

.info-value {
  font-size: 26rpx;
  color: #c9d1d9;
  flex: 1;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

.info-value.connected {
  color: #27ae60;
  font-weight: 500;
}

.info-value.disconnected {
  color: #e74c3c;
  font-weight: 500;
}

.info-value.connecting {
  color: #f39c12;
  font-weight: 500;
}

.connecting-tip {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(102, 126, 234, 0.1);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  border-radius: 12rpx;
  text-align: center;
}

.connecting-tip text {
  color: #667eea;
  font-size: 24rpx;
}

/* 缓冲区状态样式 */
.buffer-status {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(243, 156, 18, 0.1);
  border: 1rpx solid rgba(243, 156, 18, 0.3);
  border-radius: 12rpx;
}

.buffer-status .info-label {
  width: auto;
  margin-right: 8rpx;
}

.buffer-status .info-value {
  color: #f39c12;
  font-weight: 500;
}

.buffer-content {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #f39c12;
  background: rgba(0, 0, 0, 0.3);
  padding: 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(243, 156, 18, 0.3);
  word-break: break-all;
  white-space: pre-wrap;
  max-height: 200rpx;
  overflow-y: auto;
  font-family: 'SF Mono', 'Monaco', 'Menlo', monospace;
}

/* Un设备列表样式 */
.un-devices-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.device-count {
  font-size: 24rpx;
  color: #8b949e;
  font-weight: 400;
}

.no-devices-found {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #6e7681;
}

.no-devices-found text {
  display: block;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  color: #c9d1d9;
}

.no-devices-found .no-devices-tip {
  font-size: 22rpx !important;
  color: #8b949e !important;
}

.un-device-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.un-device-item:last-child {
  border-bottom: none;
}

.un-device-item:hover {
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 8rpx;
}

.device-icon {
  margin-right: 20rpx;
  flex-shrink: 0;
}

.device-emoji {
  font-size: 40rpx;
  animation: sparkle 2s ease-in-out infinite;
}

.device-details {
  flex: 1;
  min-width: 0;
}

.device-name {
  display: block;
  font-size: 28rpx;
  color: #667eea;
  font-weight: 600;
  margin-bottom: 4rpx;
  letter-spacing: 0.5rpx;
}

.device-info {
  display: block;
  font-size: 24rpx;
  color: #8b949e;
  font-weight: 400;
  letter-spacing: 0.5rpx;
  margin-bottom: 4rpx;
}

.device-time {
  display: block;
  font-size: 20rpx;
  color: #6e7681;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

.device-status {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.status-text {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  letter-spacing: 0.5rpx;
}

.status-text.online {
  color: #27ae60;
  background: rgba(39, 174, 96, 0.1);
}

.status-text.touched {
  color: #f39c12;
  background: rgba(243, 156, 18, 0.1);
}

.status-text.best {
  color: #e74c3c;
  background: rgba(231, 76, 60, 0.1);
}

.status-text.normal {
  color: #95a5a6;
  background: rgba(149, 165, 166, 0.1);
}

/* 碰一碰设备列表样式 */
.touch-devices-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.touch-device-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.touch-device-item:last-child {
  border-bottom: none;
}

.touch-device-item:hover {
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 8rpx;
}

.touch-device-item .device-emoji {
  animation: sparkle 2s ease-in-out infinite;
}

/* 输入框样式 */
.message-input { 
  background: rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(102, 126, 234, 0.5);
  color: #c9d1d9;
  padding: 18rpx; 
  border-radius: 12rpx; 
  width: 100%;
  font-size: 26rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  letter-spacing: 0.5rpx;
}

.message-input::placeholder {
  color: #8b949e;
}

.input-area {
  margin-top: 20rpx;
}

.button-group {
  display: flex;
  gap: 12rpx;
  flex-wrap: nowrap;
  align-items: center;
}

.action-button {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 12rpx; 
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  min-height: 68rpx;
  line-height: 32rpx;
  flex: 1;
  min-width: 140rpx;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.action-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.5);
}

.action-button.mini {
  flex: none;
  min-width: 100rpx;
  padding: 14rpx 20rpx;
  font-size: 22rpx;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

.action-button[disabled] {
  background: rgba(139, 148, 158, 0.3);
  color: #6e7681;
  box-shadow: none;
}

/* 消息列表区域样式 */
.msg-list { 
  background: rgba(0, 0, 0, 0.4); 
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  min-height: 200rpx; 
  max-height: 800rpx;
  overflow-y: auto;
  margin: 16rpx 0; 
  padding: 12rpx; 
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
}

/* 单条消息样式 - 修复白字白底问题 */
.msg-item { 
  margin: 8rpx 0; 
  padding: 16rpx;
  background: rgba(26, 26, 26, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  word-wrap: break-word;
  word-break: break-all;
  white-space: pre-wrap;
  width: 100%;
  max-width: calc(100% - 32rpx);
  overflow-wrap: break-word;
  box-sizing: border-box;
  overflow: hidden;
  color: #c9d1d9;
  font-family: 'SF Mono', 'Monaco', 'Menlo', monospace;
}

.no-messages {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #8b949e;
}

.no-messages text {
  font-size: 26rpx;
  color: #c9d1d9;
}

/* 设备通知样式 */
.notify-list {
  background: rgba(0, 0, 0, 0.4);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  min-height: 200rpx;
  max-height: 400rpx;
  overflow-y: scroll;
  margin: 16rpx 0;
  padding: 12rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
}

.notify-item {
  display: flex;
  margin: 4rpx 0;
  padding: 8rpx;
  background: rgba(26, 26, 26, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  font-size: 26rpx;
}

.notify-time {
  color: #8b949e;
  width: 120rpx;
  flex-shrink: 0;
  font-size: 22rpx;
}

.notify-content {
  color: #c9d1d9;
  flex: 1;
  word-wrap: break-word;
  word-break: break-all;
  white-space: pre-wrap;
  line-height: 1.4;
}

/* 调试信息样式 */
.debug-info {
  background: rgba(102, 126, 234, 0.1);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  padding: 16rpx;
  border-radius: 12rpx;
  margin: 8rpx 0;
  font-size: 24rpx;
  color: #667eea;
  backdrop-filter: blur(10rpx);
}

.debug-info text {
  display: block;
  margin: 8rpx 0;
  word-break: break-all;
  color: #c9d1d9;
}

/* 颜色设置样式 */
.color-inputs {
  margin-bottom: 24rpx;
}

.color-input-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.color-label {
  font-size: 26rpx;
  color: #8b949e;
  width: 60rpx;
  flex-shrink: 0;
  letter-spacing: 0.5rpx;
}

.color-input {
  flex: 1;
  background: rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(102, 126, 234, 0.5);
  color: #c9d1d9;
  padding: 14rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-left: 12rpx;
  letter-spacing: 0.5rpx;
}

.color-input::placeholder {
  color: #8b949e;
}

.send-colors-button {
  background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  min-height: 68rpx;
  line-height: 32rpx;
  width: 100%;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
  box-shadow: 0 4rpx 12rpx rgba(39, 174, 96, 0.3);
  transition: all 0.3s ease;
}

.send-colors-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(39, 174, 96, 0.5);
}

.send-colors-button[disabled] {
  background: rgba(139, 148, 158, 0.3);
  color: #6e7681;
  box-shadow: none;
}

/* 同步数据操作区域 */
.sync-actions {
  margin-top: 20rpx;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.refresh-button {
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 18rpx 35rpx;
  font-size: 28rpx;
  font-weight: 500;
  min-height: 75rpx;
  line-height: 40rpx;
  width: 100%;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
  box-shadow: 0 3rpx 10rpx rgba(52, 152, 219, 0.3);
  transition: all 0.3s ease;
  margin-bottom: 16rpx;
}

.refresh-button:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 6rpx rgba(52, 152, 219, 0.5);
}

.refresh-button:disabled {
  background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
  box-shadow: 0 2rpx 6rpx rgba(149, 165, 166, 0.2);
  transform: none;
}

.refresh-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  margin-top: 8rpx;
  line-height: 30rpx;
}

/* 底部操作区域 */
.bottom-actions {
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* 底部安全区域占位 - 确保按钮不被小程序底部导航栏挡住 */
.bottom-safe-area {
  height: calc(env(safe-area-inset-bottom) + 100rpx);
  min-height: 100rpx;
  width: 100%;
}


.disconnect-button {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  min-height: 80rpx;
  line-height: 40rpx;
  width: 100%;
  white-space: nowrap;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 12rpx rgba(231, 76, 60, 0.3);
  transition: all 0.3s ease;
}

.disconnect-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(231, 76, 60, 0.5);
}

/* 🔥 新增：单设备连接说明提示样式 */
.single-device-notice {
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(103, 126, 234, 0.2);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  backdrop-filter: blur(10rpx);
}

.notice-icon {
  font-size: 32rpx;
  margin-bottom: 12rpx;
}

.notice-text {
  color: #2c3e50;
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.notice-subtitle {
  color: #7f8c8d;
  font-size: 22rpx;
  line-height: 1.3;
}

/* 🧠 智能等待识别状态样式 */
.smart-waiting {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2px solid rgba(103, 126, 234, 0.3);
  border-radius: 24rpx;
  margin: 20rpx 0;
  text-align: center;
}

.waiting-animation {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.waiting-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #667eea;
  animation: waiting-pulse 1.5s infinite;
}

.waiting-dot:nth-child(2) {
  animation-delay: 0.3s;
}

.waiting-dot:nth-child(3) {
  animation-delay: 0.6s;
}

@keyframes waiting-pulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(1); }
  40% { opacity: 1; transform: scale(1.2); }
}

.waiting-text {
  color: #2c3e50;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.waiting-subtitle {
  color: #667eea;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.device-count {
  color: #7f8c8d;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

/* 🔬 设备分析进度显示 */
.analysis-progress {
  width: 100%;
  margin-top: 20rpx;
}

.device-analysis {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  margin-bottom: 8rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 12rpx;
  font-size: 22rpx;
}

.device-name {
  color: #2c3e50;
  font-weight: 500;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.device-rssi {
  color: #667eea;
  font-weight: 600;
  margin: 0 12rpx;
  min-width: 60rpx;
}

.stability-indicator {
  display: flex;
  align-items: center;
}

.stability-dots {
  display: flex;
  gap: 4rpx;
}

.stability-dots .dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(103, 126, 234, 0.2);
  transition: all 0.3s ease;
}

.stability-dots .dot.filled {
  background: #667eea;
  animation: pulse-fill 0.6s ease;
}

@keyframes pulse-fill {
  0% { transform: scale(1); background: rgba(103, 126, 234, 0.2); }
  50% { transform: scale(1.3); background: #667eea; }
  100% { transform: scale(1); background: #667eea; }
}

.more-devices {
  color: rgba(44, 62, 80, 0.6);
  font-size: 20rpx;
  text-align: center;
  margin-top: 8rpx;
  font-style: italic;
}

/* 显示其他设备按钮 */
.show-others-btn {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  transition: all 0.3s;
}

.show-others-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.98);
}

/* 其他设备标题可点击样式 */
.other-devices-title {
  display: block;
  font-size: 28rpx;
  color: #7f8c8d;
  margin-bottom: 16rpx;
  padding: 12rpx 8rpx;
  border-radius: 8rpx;
  transition: background-color 0.2s;
}

.other-devices-title:active {
  background-color: rgba(255, 255, 255, 0.1);
}

/* ===== 单设备绑定UI样式 ===== */

/* 状态指示器区域 */
.status-indicator-area {
  padding: 40rpx 0 20rpx;
  text-align: center;
}

.status-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.status-indicator.searching-my {
  background: rgba(103, 126, 234, 0.1);
  border-color: rgba(103, 126, 234, 0.3);
}

.status-indicator.searching-all {
  background: rgba(255, 193, 7, 0.1);
  border-color: rgba(255, 193, 7, 0.3);
}

.status-message {
  font-size: 32rpx;
  color: #fff;
  margin-top: 16rpx;
  text-align: center;
  font-weight: 500;
}

/* 区域标题样式 */
.section-title {
  margin: 32rpx 0 16rpx;
}

.title-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 我的设备区域 */
.my-device-section {
  margin-top: 24rpx;
}

.bound-device-card {
  background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
  border: 2px solid #667eea30;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 16rpx 0;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.bound-device-card.connected {
  border-color: #00d4aa;
  background: linear-gradient(135deg, #00d4aa15 0%, #667eea15 100%);
  box-shadow: 0 0 30rpx rgba(0, 212, 170, 0.3);
}

.bound-device-card.searching {
  border-color: #667eea;
  animation: searching-pulse 2s ease-in-out infinite;
}

.bound-device-card.offline {
  border-color: #8b949e;
  background: rgba(255, 255, 255, 0.05);
}

@keyframes searching-pulse {
  0%, 100% { 
    border-color: #667eea; 
    box-shadow: 0 0 0 rgba(103, 126, 234, 0.3);
  }
  50% { 
    border-color: #764ba2; 
    box-shadow: 0 0 20rpx rgba(103, 126, 234, 0.5);
  }
}

.bound-device-card .device-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.bound-device-card .necklace-icon {
  font-size: 48rpx;
}

.bound-device-card .device-info {
  flex: 1;
  min-width: 0;
}

.bound-device-card .device-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.bound-device-card .device-status {
  font-size: 28rpx;
  color: #8b949e;
  margin-bottom: 8rpx;
}

.bound-device-card.connected .device-status {
  color: #00d4aa;
}

.bound-device-card.searching .device-status {
  color: #667eea;
}

.connect-stats {
  font-size: 24rpx;
  color: #6c757d;
}

.device-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 16rpx;
}

.action-btn {
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  border: none;
  min-width: 120rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.action-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #8b949e;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.action-btn.danger {
  background: rgba(220, 53, 69, 0.2);
  color: #ff6b6b;
  border: 1px solid rgba(220, 53, 69, 0.3);
}

.action-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 阻止其他设备区域 */
.blocked-section {
  margin-top: 48rpx;
}

.block-notice {
  background: rgba(255, 193, 7, 0.1);
  border: 1px solid rgba(255, 193, 7, 0.3);
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.block-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.block-message {
  font-size: 28rpx;
  color: #ffc107;
  line-height: 1.4;
}

/* 可用设备区域 */
.available-devices-section {
  margin-top: 24rpx;
}

/* ===== 小屏设备特殊适配 ===== */
/* 针对小屏手机（高度 < 700rpx）的优化 */
@media (max-height: 700px) {
  .scrollable-content {
    height: calc(100vh - 100rpx);
  }
  
  .section {
    margin: 16rpx 0;
    padding: 20rpx;
  }
  
  .sync-actions {
    margin-top: 16rpx;
    padding: 12rpx 0;
  }
  
  .bottom-actions {
    margin-top: 16rpx;
    padding: 16rpx 0;
  }
  
  .top-nav {
    padding: 24rpx 32rpx 20rpx 32rpx;
  }
}

/* 针对超小屏手机（高度 < 600px）的进一步优化 */
@media (max-height: 600px) {
  .scrollable-content {
    height: calc(100vh - 80rpx);
  }
  
  .section {
    margin: 12rpx 0;
    padding: 16rpx;
  }
  
  .section-header {
    margin-bottom: 16rpx;
    padding-bottom: 12rpx;
  }
  
  .sync-actions {
    margin-top: 12rpx;
    padding: 8rpx 0;
  }
  
  .bottom-actions {
    margin-top: 12rpx;
    padding: 12rpx 0;
  }
  
  .refresh-button {
    min-height: 60rpx;
    padding: 14rpx 30rpx;
    font-size: 26rpx;
  }
  
  .disconnect-button {
    min-height: 70rpx;
    padding: 18rpx 36rpx;
    font-size: 28rpx;
  }
  
  .top-nav {
    padding: 20rpx 32rpx 16rpx 32rpx;
  }
  
  .bottom-safe-area {
    height: calc(env(safe-area-inset-bottom) + 24rpx);
    min-height: 24rpx;
  }
}

/* 针对iPhone SE等极小屏设备的适配 */
@media (max-height: 500px) {
  .scrollable-content {
    height: calc(100vh - 70rpx);
    padding: 0 24rpx;
  }
  
  .section {
    margin: 8rpx 0;
    padding: 12rpx;
    border-radius: 12rpx;
  }
  
  .section-title {
    font-size: 28rpx;
  }
  
  .device-title {
    font-size: 32rpx;
  }
  
  .back-button {
    padding: 12rpx 20rpx;
    font-size: 26rpx;
    min-height: 56rpx;
  }
  
  .top-nav {
    padding: 16rpx 24rpx 12rpx 24rpx;
  }
  
  .bottom-safe-area {
    height: calc(env(safe-area-inset-bottom) + 16rpx);
    min-height: 16rpx;
  }
}
