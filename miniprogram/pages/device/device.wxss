/* 极简设备页面样式 */
.device-page {
  min-height: 100vh;
  background: #000;
  padding: 80rpx 32rpx 200rpx 32rpx; /* 上80 左右32 下200 */
  box-sizing: border-box;
}

/* 区域标题 */
.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 24rpx;
}

/* 我的设备区域 */
.my-devices-section {
  margin-bottom: 80rpx;
}

/* 附近设备区域 */
.nearby-devices-section {
  margin-bottom: 60rpx;
}

/* 空状态提示 */
.empty-hint {
  text-align: center;
  padding: 60rpx 0;
  color: rgba(255, 255, 255, 0.3);
  font-size: 28rpx;
}

/* 扫描提示 */
.scanning-hint {
  text-align: center;
  padding: 40rpx 0;
  color: rgba(100, 150, 255, 0.8);
  font-size: 28rpx;
}

/* 设备列表 */
.device-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 设备项 */
.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  background: #000;
  border-radius: 24rpx;
  border: 2rpx solid;
  border-image: linear-gradient(135deg, #667eea 0%, #764ba2 100%) 1;
  transition: all 0.3s ease;
  position: relative;
}

/* 使用伪元素实现渐变边框 */
.device-item::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 24rpx;
  padding: 2rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.device-item.nearby {
  cursor: pointer;
}

.device-item.nearby:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.05);
}

.device-item.connected {
  background: rgba(102, 126, 234, 0.1);
}

/* 设备主要信息 */
.device-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
}

.device-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 状态指示点 */
.status-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
}

.status-dot.online {
  background: #10b981;
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.6);
}

.status-dot.offline {
  background: rgba(255, 255, 255, 0.2);
}

.device-status {
  font-size: 24rpx;
}

.device-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}

.signal-strength {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 连接箭头 */
.connect-arrow {
  font-size: 40rpx;
  color: rgba(102, 126, 234, 0.6);
  font-weight: 300;
}

/* 解绑按钮 */
.unbind-btn {
  padding: 12rpx 28rpx;
  background: transparent;
  border: 2rpx solid rgba(239, 68, 68, 0.5);
  border-radius: 16rpx;
  color: rgba(239, 68, 68, 0.8);
  font-size: 24rpx;
  transition: all 0.3s ease;
}

.unbind-btn::after {
  border: none;
}

.unbind-btn:active {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.8);
  color: #ef4444;
}

/* 底部操作区 */
.bottom-actions {
  position: fixed;
  bottom: 80rpx; /* 从底部抬高80rpx */
  left: 0;
  right: 0;
  padding: 0 32rpx 32rpx 32rpx; /* 上0 左右32 下32 */
  background: linear-gradient(to top, rgba(0, 0, 0, 0.98) 0%, rgba(0, 0, 0, 0.95) 30%, rgba(0, 0, 0, 0.8) 70%, transparent 100%);
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); /* 适配底部安全区域 */
  display: flex;
  justify-content: center;
  z-index: 100;
}

/* 操作按钮 */
.action-btn {
  width: 100%;
  max-width: 600rpx;
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  position: relative;
  overflow: hidden;
}

.action-btn::after {
  border: none;
}

/* 主要按钮 */
.action-btn.primary {
  background: #000;
  color: #fff;
}

.action-btn.primary::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 24rpx;
  padding: 3rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.action-btn.primary:active {
  background: rgba(102, 126, 234, 0.1);
}

/* 次要按钮 */
.action-btn.secondary {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  border: 2rpx solid rgba(239, 68, 68, 0.5);
}

.action-btn.secondary:active {
  background: rgba(239, 68, 68, 0.2);
  border-color: rgba(239, 68, 68, 0.8);
}
