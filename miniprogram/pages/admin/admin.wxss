/* 管理员页面样式 */
.admin-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 无权限提示 */
.no-auth {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  color: #fff;
  font-size: 32rpx;
}

/* 管理内容区 */
.admin-content {
  padding: 0 30rpx;
}

/* 当前主题卡片 */
.current-theme-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  color: #666;
}

.theme-badge {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.theme-info {
  margin-bottom: 32rpx;
}

.theme-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.theme-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/* 统计区域 */
.stats-section {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.stat-item.warning .stat-value {
  color: #ff4757;
}

/* 通用区块 */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 24rpx;
}

/* 主题列表 */
.theme-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.theme-item {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 24rpx;
  transition: all 0.3s ease;
}

.theme-item:active {
  transform: scale(0.98);
}

.theme-item.active {
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.theme-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.theme-item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.active-indicator {
  background: #5cb85c;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.theme-item-desc {
  font-size: 26rpx;
  color: #666;
}

/* 分类列表 */
.category-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.category-item {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 24rpx;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.category-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.category-badge {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  color: #fff;
  font-size: 22rpx;
}

.category-info {
  display: flex;
  gap: 24rpx;
}

.info-item {
  font-size: 24rpx;
  color: #666;
}

/* LED效果预览 */
.effect-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.effect-item {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
}

.effect-preview {
  width: 100%;
  height: 80rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.effect-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.effect-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 30rpx;
  margin-top: 60rpx;
  padding-bottom: 40rpx;
}

.btn-export,
.btn-refresh {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.btn-export {
  background: #fff;
  color: #667eea;
}

.btn-refresh {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 2rpx solid #fff;
}

.btn-export:active,
.btn-refresh:active {
  opacity: 0.8;
}