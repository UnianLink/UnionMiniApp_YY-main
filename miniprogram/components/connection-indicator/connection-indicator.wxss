/**
 * 全局连接状态指示器组件样式
 */

/* 主容器 */
.connection-indicator {
  position: fixed;
  z-index: 9999;
  pointer-events: auto;
}

/* 位置定位 */
.connection-indicator.position-top-right {
  top: 100rpx;
  right: 30rpx;
}

.connection-indicator.position-top-left {
  top: 100rpx;
  left: 30rpx;
}

.connection-indicator.position-bottom-right {
  bottom: 150rpx;
  right: 30rpx;
}

.connection-indicator.position-bottom-left {
  bottom: 150rpx;
  left: 30rpx;
}

/* 指示器主体 */
.indicator-main {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  border-radius: 50rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
  min-width: 80rpx;
  justify-content: center;
}

.indicator-main.clickable {
  cursor: pointer;
}

.indicator-main.clickable:hover {
  transform: scale(1.05);
  box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.15);
}

.indicator-main.animating {
  animation: pulse 0.3s ease-in-out;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

/* 图标 */
.status-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  transition: all 0.3s ease;
}

.status-icon:last-child {
  margin-right: 0;
}

