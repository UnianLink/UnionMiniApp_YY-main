@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 文本标签 */
.status-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #333333;
  white-space: nowrap;
}

/* 同步进度条 */
.sync-progress {
  position: absolute;
  bottom: -6rpx;
  left: 10rpx;
  right: 10rpx;
  height: 4rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 2rpx;
  overflow: hidden;
}

.sync-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #10aeff, #1296db);
  border-radius: 2rpx;
  transition: width 0.3s ease;
}

/* 详情面板 */
.details-panel {
  position: absolute;
  top: 70rpx;
  right: 0;
  width: 400rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(15px);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  transform: scale(0.8) translateY(-20rpx);
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
}

.details-panel.show {
  transform: scale(1) translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.details-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.details-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.close-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 20rpx;
  color: #666666;
  font-size: 24rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #666666;
}

.detail-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

/* 信号强度显示 */
.signal-bars {
  display: flex;
  align-items: flex-end;
  gap: 2rpx;
  height: 20rpx;
}

.signal-bar {
  width: 4rpx;
  background: #ddd;
  border-radius: 2rpx;
  transition: background-color 0.3s ease;
}

.signal-bar.bar-1 { height: 6rpx; }
.signal-bar.bar-2 { height: 10rpx; }
.signal-bar.bar-3 { height: 14rpx; }
.signal-bar.bar-4 { height: 18rpx; }

.signal-bar.active {
  background: #10aeff;
}

/* 刷新按钮 */
.refresh-btn {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  background: #10aeff;
  color: white;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  outline: none;
}

.refresh-btn:active {
  background: #0e8fd9;
  transform: scale(0.98);
}

/* 暗色主题 */
.connection-indicator.theme-dark .indicator-main {
  background: rgba(0, 0, 0, 0.8);
  border-color: rgba(255, 255, 255, 0.1);
}

.connection-indicator.theme-dark .status-label {
  color: #ffffff;
}

.connection-indicator.theme-dark .details-panel {
  background: rgba(0, 0, 0, 0.9);
  border-color: rgba(255, 255, 255, 0.1);
}

.connection-indicator.theme-dark .details-title {
  color: #ffffff;
}

.connection-indicator.theme-dark .detail-label {
  color: #cccccc;
}

.connection-indicator.theme-dark .detail-value {
  color: #ffffff;
}

.connection-indicator.theme-dark .close-btn {
  background: rgba(255, 255, 255, 0.1);
  color: #cccccc;
}

/* 同步反馈浮层 */
.sync-feedback {
  position: absolute;
  top: 0;
  right: 100rpx;
  min-width: 250rpx;
  max-width: 350rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid;
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  gap: 12rpx;
  transform: translateX(20rpx);
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.sync-feedback.show {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.feedback-icon {
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.feedback-message {
  font-size: 26rpx;
  font-weight: 500;
  flex: 1;
  line-height: 1.4;
}

.feedback-close {
  font-size: 24rpx;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
  cursor: pointer;
}

.feedback-close:active {
  transform: scale(0.9);
}

.feedback-progress {
  position: absolute;
  bottom: 4rpx;
  left: 12rpx;
  right: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  opacity: 0.3;
  overflow: hidden;
}

.feedback-progress-fill {
  height: 100%;
  border-radius: 2rpx;
  transition: width 0.3s ease;
}

/* 不同位置的反馈浮层 */
.connection-indicator.position-top-left .sync-feedback {
  right: auto;
  left: 100rpx;
  transform: translateX(-20rpx);
}

.connection-indicator.position-top-left .sync-feedback.show {
  transform: translateX(0);
}

.connection-indicator.position-bottom-right .sync-feedback,
.connection-indicator.position-bottom-left .sync-feedback {
  top: auto;
  bottom: 0;
}

/* 响应式适配 */
@media (max-width: 350px) {
  .details-panel {
    width: 320rpx;
    padding: 24rpx;
  }
  
  .sync-feedback {
    min-width: 200rpx;
    max-width: 280rpx;
    padding: 12rpx 16rpx;
  }
  
  .feedback-message {
    font-size: 24rpx;
  }
}